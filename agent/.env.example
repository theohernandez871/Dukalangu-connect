# Base URL ya Supabase project yako
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Anon key ya Supabase (Project Settings -> API)
SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Token ya agent uliyopewa kwenye dashboard (inaonyeshwa mara moja tu)
AGENT_TOKEN="paste_agent_token_here"

# Hiari: muda wa kupoll (millisekunde). Default 3000
POLL_INTERVAL_MS=3000

# Hiari: timeout ya kuunganisha router (millisekunde). Default 8000
ROUTER_TIMEOUT_MS=8000

# Hiari: lazimisha host ya router (kawaida haihitajiki - server inatoa)
# ROUTER_HOST="192.168.88.1"
