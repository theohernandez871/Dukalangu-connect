# ==========================================================
# Hotspot Billing — Enterprise Agent — Configuration
# ==========================================================

# Base URL ya Supabase project yako
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Anon key ya Supabase (Project Settings -> API)
SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Token ya agent uliyopewa kwenye dashboard (mara ya kwanza tu).
# Baada ya kuanzishwa, token huhifadhiwa kwa usalama (encrypted),
# hivyo huhitaji kuiweka tena kwenye env.
AGENT_TOKEN="paste_agent_token_here"

# --- Hiari (zina thamani za default) ---

# Muda kati ya kupoll commands (millisekunde). Default 3000
POLL_INTERVAL=3000

# Muda kati ya heartbeat (millisekunde). Default 30000 (sekunde 30)
HEARTBEAT_INTERVAL=30000

# Timeout ya kuunganisha RouterOS API (millisekunde). Default 8000
API_TIMEOUT=8000

# Kiwango cha logi: debug | info | warn | error. Default info
LOG_LEVEL=info

# Hiari: siri ya ziada kwa encryption ya token store (machine-bound).
# AGENT_SECRET="chagua-siri-ndefu"

# Hiari: folda za data + logs
# AGENT_DATA_DIR="./.agent-data"
# LOG_DIR="./logs"
